# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://tiendita:tiendita_dev@localhost:5435/tiendita_development

# Redis
REDIS_URL=redis://localhost:6380

# NestJS Observe
# Keep real credentials only in .env.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_FORWARD_LOGS=false
